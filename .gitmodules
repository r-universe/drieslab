	path = edgeicgrs
	url = https://github.com/drieslab/edgeicgrs
[submodule "smotif"]
	path = smotif
	url = https://github.com/drieslab/smotif
[submodule "smotifrs"]
	path = smotifrs
	url = https://github.com/drieslab/smotifrs
[submodule "spatialDWLS"]
	path = spatialDWLS
	url = https://github.com/drieslab/spatialDWLS
[submodule "tilework"]
	path = tilework
	url = https://github.com/drieslab/tilework
	branch = dev
